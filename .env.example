# Copy to .env and fill in. `docker compose` reads this file automatically.

# ---------------------------------------------------------------- LiveKit ---
# LiveKit Cloud, or your own server (ws://livekit:7880 for a local deployment).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Leave empty to have the worker join every room automatically. Set a name only
# if you dispatch the agent explicitly.
SOFIA_S2S_AGENT_NAME=agent-sofia

# ------------------------------------------------------------------- LLM ----
# Any OpenAI-compatible endpoint: vLLM, llama.cpp server, Ollama, TGI, LM Studio,
# or a hosted API. Must end in /v1.
SOFIA_QAA_LLM_BASE_URL=http://host.docker.internal:8000/v1
SOFIA_QAA_LLM_API_KEY=not-needed
SOFIA_QAA_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Host loopback port publishing the qaa-agent (the container always listens on
# 8000). Override when the host already uses 8000, then `task ask` follows it.
SOFIA_QAA_HOST_PORT=8000

# Hard ceiling on reply length. Spoken answers should be short — raising this
# mostly buys you monologues the person will talk over.
SOFIA_QAA_MAX_TOKENS=320
SOFIA_QAA_TEMPERATURE=0.6

# ----------------------------------------------------------------- speech ---
# BCP-47-ish language code passed to Whisper and used as context for the brain.
SOFIA_LANGUAGE=it

# --- which ASR the agent listens with -------------------------------------
# false: batch Whisper. Accurate, punctuated, multilingual — but transcription
#        only starts once the person stops talking (adds 200-500ms per turn).
# true : streaming — see SOFIA_STT_STREAMING_ENGINE below for which engine.
SOFIA_STT_STREAMING=true

# Which backends the stt service loads: batch | streaming | both.
# `both` costs memory but lets you flip SOFIA_STT_STREAMING with one restart.
SOFIA_STT_BACKEND=both

# Batch engine: nemotron (default) or whisper. Nemotron 3.5 ASR is 638M, cased,
# punctuated, ~0.08 RTF on a CPU core, and covers 40 locales including Italian.
# Switch to whisper only for a language Nemotron does not list — and change
# SOFIA_STT_MODEL_ID to match (e.g. openai/whisper-large-v3-turbo).
SOFIA_STT_BATCH_ENGINE=nemotron
SOFIA_STT_MODEL_ID=nvidia/nemotron-3.5-asr-streaming-0.6b

# Streaming engine: sherpa (default) | parakeet.
# sherpa   : zipformer via sherpa-onnx. English-only by default, no
#            punctuation, lower accuracy, runs on any CPU.
# parakeet : Nemotron 3.5 ASR via parakeet.cpp/ggml. Punctuated, cased, covers
#            Italian — but needs docker/audio.Dockerfile's Vulkan (default) or
#            CUDA build, so a GPU-capable host. See docs/details.md.
SOFIA_STT_STREAMING_ENGINE=parakeet

# Streaming model (sherpa-onnx release asset), downloaded on first boot.
# Other languages — there is no streaming-sherpa Italian model; either use
# SOFIA_STT_STREAMING_ENGINE=parakeet above, or batch Whisper:
#   ...-streaming-zipformer-fr-2023-04-14.tar.bz2        French
#   ...-streaming-zipformer-de-kroko-2025-08-06.tar.bz2  German (57 MB)
#   ...-streaming-zipformer-es-kroko-2025-08-06.tar.bz2  Spanish
#   ...-streaming-zipformer-en-kroko-2025-08-06.tar.bz2  English, small (57 MB)
#   ...-streaming-paraformer-bilingual-zh-en.tar.bz2     Chinese + English
SOFIA_STT_SHERPA_MODEL_URL=https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/sherpa-onnx-streaming-zipformer-en-2023-06-26.tar.bz2

# Parakeet streaming model (pre-converted GGUF), downloaded on first boot.
# q8_0 measured smaller, marginally faster and no less accurate than f16 on
# one Italian clip (not a full WER corpus) — see
# openspec/changes/add-parakeet-streaming-asr/tasks.md 7.2. Other
# quantisations: https://huggingface.co/mudler/parakeet-cpp-gguf (f16, q6_k, q5_k, q4_k).
SOFIA_STT_PARAKEET_MODEL_URL=https://huggingface.co/mudler/parakeet-cpp-gguf/resolve/main/nemotron-3.5-asr-streaming-0.6b-q8_0.gguf

# Trailing silence (seconds) that ends a turn. Lower feels snappier but cuts
# people off mid-thought; higher feels polite but sluggish. Applies to both
# streaming engines: sherpa's own endpointing rule, and parakeet's — Nemotron
# has no end-of-utterance signal of its own, so ParakeetSession implements
# this rule itself.
SOFIA_STT_ENDPOINT_SILENCE=0.8

# Floor and ceiling (seconds) for LiveKit's own semantic turn detector, on top
# of the STT-side silence rule above. The ceiling is the one that bites: an
# uncertain semantic model waits up to this long before deciding the person is
# done. 5.0s is LiveKit's own conservative default; measured stalling a real
# turn to its full length feels sluggish for a voice agent. Lower it for a
# more reactive agent — the trade-off is a higher chance of cutting someone
# off mid-thought on a genuinely ambiguous pause.
SOFIA_S2S_MIN_ENDPOINTING_DELAY=0.4
SOFIA_S2S_MAX_ENDPOINTING_DELAY=5.0

# Kokoro voice. The first letter picks the language pipeline:
#   a=American en  b=British en  i=Italian  f=French  e=Spanish
#   p=Portuguese   h=Hindi       j=Japanese z=Mandarin
# e.g. af_heart, am_michael, bf_emma, if_sara, im_nicola
SOFIA_TTS_VOICE=if_sara

# auto | cuda | cpu. `cuda` also means "the AMD GPU" under the ROCm build.
SOFIA_AUDIO_DEVICE=auto

# --------------------------------------------------------------- storage ----
# Where downloaded weights land — plain host directories (`ls` them, they are
# not hidden inside a Docker-managed volume), relative to wherever you run
# `docker compose`/`task up:*` from. `task up:*` creates these and opens their
# permissions before starting the stack; if you start containers another way,
# do the same yourself first (`mkdir -p` + `chmod -R a+rwX` both paths) — a
# bind mount Docker auto-creates comes back root-owned, and the container's
# non-root user can't write into that.
SOFIA_MODELS_HOST_DIR=./data/models
SOFIA_HF_CACHE_HOST_DIR=./data/hf-cache

# --------------------------------------------------------------- ROCm only ---
# Only needed for consumer AMD cards ROCm does not officially list.
# RDNA2 (6700/6800/6900): 10.3.0 — RDNA3 (7900): 11.0.0
# RDNA4 (9060/9070): leave empty — supported natively by the rocm7.2 wheels.
HSA_OVERRIDE_GFX_VERSION=

# --------------------------------------------------------------- logging ----
SOFIA_LOG_LEVEL=INFO

# ----------------------------------------------------------- development ---
# SOFIA_STT_RELOAD / SOFIA_TTS_RELOAD / SOFIA_QAA_RELOAD are not meant to be
# set here — compose.dev.yaml sets them directly. See that file for the full
# hot-reload workflow (bind-mounts ./src, needs an editable install baked in
# via each Dockerfile's DEV build arg): `docker compose -f compose.yaml -f
# compose.rocm.yaml -f compose.dev.yaml up --build`.
