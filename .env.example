# Copy to .env and fill in. `docker compose` reads this file automatically.

# ---------------------------------------------------------------- LiveKit ---
# LiveKit Cloud, or your own server (ws://livekit:7880 for a local deployment).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Leave empty to have the worker join every room automatically. Set a name only
# if you dispatch the agent explicitly.
SOFIA_S2S_AGENT_NAME=

# ------------------------------------------------------------------- LLM ----
# Any OpenAI-compatible endpoint: vLLM, llama.cpp server, Ollama, TGI, LM Studio,
# or a hosted API. Must end in /v1.
SOFIA_QAA_LLM_BASE_URL=http://host.docker.internal:8000/v1
SOFIA_QAA_LLM_API_KEY=not-needed
SOFIA_QAA_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Hard ceiling on reply length. Spoken answers should be short — raising this
# mostly buys you monologues the person will talk over.
SOFIA_QAA_MAX_TOKENS=320
SOFIA_QAA_TEMPERATURE=0.6

# ----------------------------------------------------------------- speech ---
# BCP-47-ish language code passed to Whisper and used as context for the brain.
SOFIA_LANGUAGE=en

# --- which ASR the agent listens with -------------------------------------
# false: batch Whisper. Accurate, punctuated, multilingual — but transcription
#        only starts once the person stops talking (adds 200-500ms per turn).
# true : streaming sherpa-onnx. Decodes while they speak, so end-of-turn is
#        nearly free. English-only by default, no punctuation, lower accuracy.
SOFIA_STT_STREAMING=false

# Which backends the stt service loads: batch | streaming | both.
# `both` costs memory but lets you flip SOFIA_STT_STREAMING with one restart.
SOFIA_STT_BACKEND=both

# Batch engine: nemotron (default) or whisper. Nemotron 3.5 ASR is 638M, cased,
# punctuated, ~0.08 RTF on a CPU core, and covers 40 locales including Italian.
# Switch to whisper only for a language Nemotron does not list — and change
# SOFIA_STT_MODEL_ID to match (e.g. openai/whisper-large-v3-turbo).
SOFIA_STT_BATCH_ENGINE=nemotron
SOFIA_STT_MODEL_ID=nvidia/nemotron-3.5-asr-streaming-0.6b

# Streaming model (sherpa-onnx release asset), downloaded on first boot.
# Other languages — there is NO streaming Italian model; use batch Whisper for it:
#   ...-streaming-zipformer-fr-2023-04-14.tar.bz2        French
#   ...-streaming-zipformer-de-kroko-2025-08-06.tar.bz2  German (57 MB)
#   ...-streaming-zipformer-es-kroko-2025-08-06.tar.bz2  Spanish
#   ...-streaming-zipformer-en-kroko-2025-08-06.tar.bz2  English, small (57 MB)
#   ...-streaming-paraformer-bilingual-zh-en.tar.bz2     Chinese + English
SOFIA_STT_SHERPA_MODEL_URL=https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/sherpa-onnx-streaming-zipformer-en-2023-06-26.tar.bz2

# Trailing silence (seconds) that ends a turn. Lower feels snappier but cuts
# people off mid-thought; higher feels polite but sluggish.
SOFIA_STT_ENDPOINT_SILENCE=0.8

# Kokoro voice. The first letter picks the language pipeline:
#   a=American en  b=British en  i=Italian  f=French  e=Spanish
#   p=Portuguese   h=Hindi       j=Japanese z=Mandarin
# e.g. af_heart, am_michael, bf_emma, if_sara, im_nicola
SOFIA_TTS_VOICE=af_heart

# auto | cuda | cpu. `cuda` also means "the AMD GPU" under the ROCm build.
SOFIA_AUDIO_DEVICE=auto

# --------------------------------------------------------------- ROCm only ---
# Only needed for consumer AMD cards ROCm does not officially list.
# RDNA2 (6700/6800/6900): 10.3.0 — RDNA3 (7900): 11.0.0
HSA_OVERRIDE_GFX_VERSION=

# --------------------------------------------------------------- logging ----
SOFIA_LOG_LEVEL=INFO
